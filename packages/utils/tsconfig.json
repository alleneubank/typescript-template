{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // Referenced projects cannot disable emit (TS6310). Declarations go to
    // .tsbuild so they stay out of dist/, which tsdown owns and cleans.
    "outDir": "./.tsbuild",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": ["src"],
  "references": [
    {
      "path": "../core"
    }
  ]
}
