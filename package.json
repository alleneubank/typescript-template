{
  "name": "typescript-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
    "typecheck": "bun --check -b",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "test": "bun --conditions=@template/source test",
    "knip": "knip",
    "jscpd": "jscpd .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "npm:bun-types@1.4.3",
    "jscpd": "^5.4.1",
    "knip": "^6.42.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.22.14"
  },
  "engines": {
    "bun": "1.4.3"
  }
}
